<?xml version="1.0" encoding="utf-8"?>
<animated-selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:id="@+id/state_active" android:state_checked="true">
        <layer-list>
            <item android:gravity="top">
                <shape android:shape="rectangle">
                    <size android:height="4dp" />
                    <solid android:color="@color/nav_button" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item android:id="@+id/state_inactive" android:state_checked="false">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>

    <transition
        android:fromId="@id/state_inactive"
        android:toId="@id/state_active">
        <animation-list>
            <item android:duration="200">
                <layer-list>
                    <item android:gravity="top">
                        <shape android:shape="rectangle">
                            <size android:height="4dp" />
                            <solid android:color="@color/nav_button"/>
                        </shape>
                    </item>
                </layer-list>
            </item>
        </animation-list>
    </transition>
</animated-selector>
